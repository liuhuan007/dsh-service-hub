{
  "name": "dsh-service-hub",
  "version": "0.2.0",
  "type": "module",
  "description": "Service Hub for DeepSeek Harness — start, stop and monitor local services, scripts and terminal tools from a sidebar panel. 服务面板：在 DSH 侧栏一键启停本机服务。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "plugin",
    "service-manager",
    "process-manager",
    "local-services",
    "sidebar-panel"
  ],
  "license": "MIT",
  "author": "liuhuan007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhuan007/dsh-service-hub.git"
  },
  "homepage": "https://github.com/liuhuan007/dsh-service-hub#readme",
  "bugs": {
    "url": "https://github.com/liuhuan007/dsh-service-hub/issues"
  },
  "engines": {
    "dsh": ">=0.2.1"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": false
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "dsh-better-sidebar"
      ]
    },
    "manifestVersion": 1
  }
}